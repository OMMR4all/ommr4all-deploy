# ── OMMR4all Docker configuration ──────────────────────────────────────────
# ./start.sh copies this file to .env on first run, so the defaults below are
# what you get out of the box. Edit .env (not this file) and re-run ./start.sh
# to change anything.
#
# Every variable here is optional and shown with its effective default. A line
# that is commented out behaves exactly like the default; an *empty* assignment
# (FOO=) is passed to the container as an empty string, which the code treats as
# "unset" everywhere in this file.
#
# Not every setting of the application lives here — only those that have to be
# decided before the server starts. Anything that can change while it runs
# (users, permissions, models, default books) is configured in the web UI.


# ════════════════════════════════════════════════════════════════════════════
#  Network
# ════════════════════════════════════════════════════════════════════════════

# Host port that maps to the container's Apache (internal port 8001).
# Access the app at http://localhost:<PORT>
PORT=8001


# ── Reverse proxy / CSRF ────────────────────────────────────────────────────
# When a TLS terminating proxy (nginx, Apache, Traefik, …) forwards to the port
# above, the request arrives inside the container as plain HTTP. Django would
# then compare the browser's "Origin: https://your.host" against its own idea of
# the origin ("http://your.host") and reject every form post — including the
# /admin/ login — with "Forbidden (403) CSRF verification failed".
# With this set to 1 the X-Forwarded-Proto / X-Forwarded-Host headers of the
# proxy are trusted, which makes the two agree again. Set it to 0 only if the
# app is reachable directly, without a proxy in front of it — a client could
# otherwise forge those headers.
OMMR4ALL_TRUST_PROXY_HEADERS=1

# Only needed if the proxy sends neither of those headers, or if the public URL
# differs from the Host it forwards: comma separated origins *with* scheme, e.g.
# OMMR4ALL_CSRF_TRUSTED_ORIGINS=https://ommr4all.example.org,http://192.168.0.5:8001
OMMR4ALL_CSRF_TRUSTED_ORIGINS=


# ════════════════════════════════════════════════════════════════════════════
#  Storage and database
# ════════════════════════════════════════════════════════════════════════════

# Absolute (or relative) path on the HOST where book/page data is stored.
# This directory is volume-mounted into the container; data survives rebuilds.
#
# Linux / macOS:
STORAGE=./storage
#
# Windows (use forward slashes or drive letter):
# STORAGE=C:/Users/yourname/ommr4all-storage

# The SQLite database (users, permissions, book index). By default it is kept
# inside STORAGE as <STORAGE>/db.sqlite3, so data and database move together.
#
# Set DB_DIR to a different HOST directory to keep the database elsewhere —
# e.g. the data on a large/network drive and the database on a fast local disk.
# Leave empty to use STORAGE.
DB_DIR=
# Filename of the database inside that directory.
DB_NAME=db.sqlite3

# On start the container makes the storage tree readable/writable for the Apache
# worker user (www-data), which is needed when the books were created by another
# user on the host. This is a recursive chmod over the whole tree — on a large
# storage directory it adds minutes to every start. Set to 0 to skip it (then
# make sure www-data can already read and write the tree, or every request
# fails with SQLite/permission errors).
FIX_STORAGE_PERMISSIONS=1

# Warn-level log entry when saving a single page takes longer than this many
# seconds. Diagnoses slow (e.g. network) storage; it never aborts a save.
# OMMR4ALL_SLOW_SAVE_SECONDS=0.5


# ════════════════════════════════════════════════════════════════════════════
#  Superuser (only used when the database is empty / first run)
# ════════════════════════════════════════════════════════════════════════════

# If DJANGO_SUPERUSER_USERNAME is set, a superuser is created automatically
# on first start if none exists. Leave blank to skip (create manually with
# `docker compose exec web … manage.py createsuperuser` instead).
# The password is visible to anyone who can read this file or run
# `docker inspect` — change it in the UI after the first login.
#
# All three are required together: with a username set but no password the
# creation fails, and the email must pass Django's validator — the domain needs
# a dot ("admin@example.com"), the only dotless domain accepted is "localhost".
# An invalid value aborts the startup, so the container never comes up.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=


# ════════════════════════════════════════════════════════════════════════════
#  GPUs
# ════════════════════════════════════════════════════════════════════════════

# Which GPUs the task scheduler may run tasks on. One worker slot is created per
# device, so a host with two cards can run two GPU tasks at once (e.g. a training
# run and a prediction). Each worker is pinned to its device via
# CUDA_VISIBLE_DEVICES, so the tasks never share a card.
#
# Leave empty to detect the installed cards automatically.
# Set explicitly to restrict, e.g. OMMR4ALL_GPUS=0,1 — or to "none" to run
# everything on the CPU.
OMMR4ALL_GPUS=

# This only distributes the tasks; whether torch can talk to the cards at all is
# decided when the image is built. The default build is CUDA 13 and needs a 580+
# driver: on an older driver start the stack with ./start.sh --gpu-cuda (cu126),
# on Pascal cards (GTX 10xx, P100) with ./start.sh --gpu-legacy. See the GPU
# section of the README. That choice is a *build* argument (GPU_MODE) and
# deliberately not set here — start.sh exports it from its flags, and an
# exported shell variable overrides this file.


# ════════════════════════════════════════════════════════════════════════════
#  Task scheduler
# ════════════════════════════════════════════════════════════════════════════
# Prediction and training runs are executed by worker processes supervised by a
# scheduler inside the web process. The defaults are sized for a normal install;
# touch these only to diagnose or work around stuck tasks.

# Seconds a worker stays alive without a task. Workers are kept warm so the next
# task reuses the loaded model; after this they exit and free their RAM/VRAM.
# 0 disables the idle shutdown (workers live forever).
# TASK_WORKER_IDLE_TIMEOUT=600

# Seconds to wait for a worker to react to each of SIGTERM and SIGKILL before
# giving up on it. A process in uninterruptible sleep (D state, e.g. a wedged
# GPU driver) accepts neither, so the wait is capped rather than blocking.
# TASK_WORKER_TERMINATE_TIMEOUT=5

# Seconds without a scheduler heartbeat after which it counts as wedged and is
# restarted. The loop ticks every 100 ms, so this is very generous on purpose:
# a restart is disruptive, a slow loop is not.
# TASK_SCHEDULER_STALL_TIMEOUT=60

# Seconds of wall clock a single task may run, 0 = no limit (the default).
# Trainings legitimately run for hours, so this is an opt-in backstop.
# TASK_MAX_RUNTIME=0

# Seconds between two runs of the watchdog that restarts a dead or stalled
# scheduler. Values <= 0 disable supervision and exist only for tests.
# TASK_OPERATION_WATCHER_INTERVAL=30


# ════════════════════════════════════════════════════════════════════════════
#  Training dataset memory
# ════════════════════════════════════════════════════════════════════════════

# Training datasets are built from the ground truth on every run and kept in
# memory. Once they grow past this budget the samples are written to disk and
# read back batch by batch instead, so a dataset bigger than the RAM no longer
# ends the run with a MemoryError.
#
# Leave empty for 40 % of the RAM free when the run starts (at least 512 MB).
# Set a number of megabytes to pin it, or 0 to always go to disk.
# OMMR4ALL_DATASET_MEMORY_BUDGET_MB=
#
# Where those samples are written. Default: the container's temp directory,
# which lives in the writable layer — point this at a mounted volume (add it to
# `volumes:` in docker-compose.yml) if your datasets are larger than that.
# The directory is removed when the training ends.
# OMMR4ALL_DATASET_CACHE_DIR=


# ════════════════════════════════════════════════════════════════════════════
#  LLM text transcription (text_llm step, all optional)
# ════════════════════════════════════════════════════════════════════════════
# The local Chandra 2 model (datalab-to/chandra-ocr-2) is always offered if
# transformers/torch are installed. Cloud providers are only enabled in the
# client if their API key is configured here — keys stay on the server and are
# never entered in or sent from the browser.

# ── Google Gemini ───────────────────────────────────────────────────────────
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alias; GEMINI_API_KEY wins if both are set.
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ── OpenAI-compatible endpoint ──────────────────────────────────────────────
# OpenAI, OpenRouter, or a local vLLM/LM Studio server — for a local server set
# OPENAI_API_URL, the key may stay empty. Setting *either* of the two enables
# the provider in the client.
OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Upper bound on the page image handed to a local vision model. The vision tower
# attends globally over the image patches, so its memory grows with the square of
# the pixel count. Lower this if the step runs out of graphics memory.
# OMMR4ALL_LLM_MAX_PIXELS=2000000

# Directory holding API key files, used by the offline batch tool
# (tools/gemini_batch_lyrics.py) instead of putting the key in this file. It
# looks for api_key / key / gemini_api_key / google_api_key(.txt) inside it, and
# falls back to the variables above. The path is *container-side*, so the
# directory has to be mounted in (add it to `volumes:` in docker-compose.yml).
# GEMINI_API_KEY_DIR=
# Same, as a shared fallback for all providers; GEMINI_API_KEY_DIR wins.
# OMMR4ALL_API_KEY_DIR=


# ════════════════════════════════════════════════════════════════════════════
#  Rarely needed
# ════════════════════════════════════════════════════════════════════════════

# Output directory of the discovery CLI (omr/discovery). Container-side path;
# defaults to storage_discovery next to the server checkout, i.e. inside the
# image — set it into a mounted directory if you use the tool.
# OMMR4ALL_DISCOVERY_OUT=

# Channel layer for websocket broadcasts (live chant/document updates), shared
# by the web and ws services. docker-compose.yml points both at the bundled
# redis service; only override this to use an external Redis.
# REDIS_URL=redis://redis:6379/0


# ════════════════════════════════════════════════════════════════════════════
#  Submodule branches (used by setup_branches.sh, not by Docker)
# ════════════════════════════════════════════════════════════════════════════
# Which git branch to check out for each Python/Angular submodule. The image is
# built from the local checkout, so these only matter via setup_branches.sh:
# change them, run ./setup_branches.sh, then rebuild with ./start.sh --no-cache.
SERVER_BRANCH=master
CLIENT_BRANCH=master
LINE_DETECTION_BRANCH=master
LAYOUT_ANALYSIS_BRANCH=master


# ════════════════════════════════════════════════════════════════════════════
#  Set elsewhere — listed so you don't look for them here
# ════════════════════════════════════════════════════════════════════════════
# GPU_MODE                 build argument choosing the torch build; set by the
#                          ./start.sh --gpu-cuda / --gpu-legacy flags (see above)
# DEPLOY_LOGLEVEL          verbosity of the deploy script *during the image
#                          build*; pass with --build-arg, not here
# OMMR4ALL_STORAGE_ROOT    container-side storage path, derived from STORAGE
# OMMR4ALL_DB_PATH         container-side database path, from DB_DIR + DB_NAME
# DJANGO_SETTINGS_MODULE   fixed to ommr4all.settings
# CUDA_VISIBLE_DEVICES     set per task worker from OMMR4ALL_GPUS; overriding it
#                          globally would make every worker use the same card
